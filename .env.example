# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=*
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database Configuration
# Local Docker: postgresql+asyncpg://postgres:postgrespassword@postgres:5432/sentinel_db
# Cloud (Neon): postgresql+asyncpg://<user>:<password>@<endpoint>.neon.tech/sentinel_db?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/sentinel_db

# Redis & Broker Configuration
# Local Docker: redis://redis:6379/0
# Cloud (Upstash): rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Outbound Delivery Parameters
MAX_DISPATCH_RETRIES=5
INITIAL_RETRY_DELAY_SECONDS=2.0
MAX_RETRY_DELAY_SECONDS=60.0
HTTP_CONNECT_TIMEOUT_SECONDS=2.0
HTTP_READ_TIMEOUT_SECONDS=5.0
SSRF_PROTECTION_ENABLED=true
